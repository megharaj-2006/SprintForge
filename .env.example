# ============================================================================
# SprintForge Enterprise Platform - Environment Variable Template
# ============================================================================

# Spring Active Profile (local, dev, test, prod)
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
TZ=UTC

# Database Configuration
POSTGRES_DB=SprintForge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_URL=jdbc:postgresql://postgres:5432/SprintForge
DB_USERNAME=postgres
DB_PASSWORD=postgres
HIKARI_MAX_POOL_SIZE=20
HIKARI_MIN_IDLE=5

# Security & JWT Token Secrets
JWT_SECRET=9a6747fc6259aa374ab4e1bb2a0918d653777c5760848033282b8a74e622b7c6
JWT_EXPIRATION=86400000
APP_CORS_ALLOWED_ORIGINS=*

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password_123

# File Storage
STORAGE_LOCATION=/app/uploads

# Port Bindings
NGINX_PORT=80
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Monitoring Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_secure_password_123
