# ==============================================================================
# SprintForge Enterprise Platform Environment Configuration Example
# Copy this file to .env and fill in your actual environment secrets
# ==============================================================================

# Application Server
SERVER_PORT=8080

# Database Credentials
DB_URL=jdbc:postgresql://localhost:5432/SprintForge
DB_USERNAME=postgres
DB_PASSWORD=

# Security / JWT Configuration
# Generate a 256-bit secret key (e.g. openssl rand -hex 32)
JWT_SECRET=
JWT_EXPIRATION=86400000

# Integration / AI Credentials (Optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SLACK_BOT_TOKEN=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JIRA_API_TOKEN=
LINEAR_API_KEY=
NOTION_API_KEY=
